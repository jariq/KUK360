# Test environment for the AppImage on other distributions, used by
# build/linux/tools/test-distros.sh: BASE is a Debian based image (ubuntu:22.04, debian:12).
#
# Only what a desktop with GNOME has anyway: GTK 3 (which brings X11, XCB, Wayland, cairo,
# pango, fontconfig, GLib...), OpenGL/EGL, D-Bus and libxkbcommon-x11 (needed by the window
# managers of X11 desktops: mutter, kwin, muffin...). Libraries missing beyond that are found
# by the test. In addition the test tools: a virtual X server, xdotool to focus the window
# (there is no window manager), xwd for the screenshot and the Mesa drivers for software
# OpenGL (llvmpipe).
ARG BASE
FROM ${BASE}

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgtk-3-0 libgl1 libegl1 libfontconfig1 libdbus-1-3 libxkbcommon-x11-0 \
        xvfb xauth xdotool x11-apps libgl1-mesa-dri fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
