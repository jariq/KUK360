// Windows resources of KUK360.exe, configured by CMake (configure_file) into the build
// directory: executable icon, version information shown in the file properties and,
// with MinGW, the application manifest.

#include <winver.h>

IDI_ICON1 ICON "@KUK360_RC_ICON@"
@KUK360_RC_MANIFEST@

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "KUK360"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "KUK360"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "@KUK360_COPYRIGHT@"
            VALUE "Comments", "@PROJECT_DESCRIPTION@"
            VALUE "InternalName", "KUK360"
            VALUE "OriginalFilename", "KUK360.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
